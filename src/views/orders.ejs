<%- include('parts/header') %>
<%- include('parts/navbar') %>

<% if (validationError) { %>
    <p class="alert alert-danger">
        <%= validationError.message %>
    </p>
<% } %>

<div class="container">
    <% if (orders.length === 0) { %>
        <p class="alert alert-danger">There is no orders</p>
    <% } else { %>
        <table>
            <thead>
                <td>no</td>
                <td>Cost</td>
                <td>Address</td>
                <td>Status</td>
                <td></td>
            </thead>
            <tbody>
                <% for (let i = 0; i < orders.length; ++i) { %>
                    <tr>
                        <td> <%= i + 1 %> </td>
                        <td>
                            <table>
                                <thead>
                                    <td>no</td>
                                    <td>Product name</td>
                                    <td>Price</td>
                                    <td>Amount</td>
                                    <td>Total</td>
                                    <td></td>
                                </thead>
                                <tbody>
                                    <% for (let j = 0; j < orders[i].items.length; ++j) { %>
                                        <tr>
                                            <td> <%= i + 1 %> </td>
                                            <td> <%= orders[i].items[j].name %> </td>
                                            <td> <%= orders[i].items[j].price %> $ </td>
                                            <td> <%= orders[i].items[j].amount %> </td>
                                            <td> <%= orders[i].items[j].price * orders[i].items[j].amount %> $ </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </td>
                        <td> <%= orders[i].cost %> $ </td>
                        <td> <%= orders[i].address %> </td>
                        <td> <%= orders[i].status %> </td>
                        <form method="POST" action="/orders/cancel">
                            <td>
                                <input type="hidden" name="orderId" value="<%= orders[i]._id %>">
                                <input type="submit" class="btn btn-danger" value="Cancel">
                            </td>
                        </form>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } %>
    <% if (orders.length) { %>
        <form method="POST" action="/orders/cancel-all">
            <input type="submit" class="btn btn-danger" value="Cancel All">
        </form>
    <% } %>
</div>

<%- include('parts/footer') %>