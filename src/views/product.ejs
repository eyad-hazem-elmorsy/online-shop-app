<%- include('parts/header') %>
<%- include('parts/navbar') %>
<%- include('parts/flash-messages') %>

<div class="container py-5">

    <% if (!product) { %>
        <div class="alert alert-danger" role="alert">
            Product not found
        </div>
    <% } else { %>
        <div class="row g-5">
            <div class="col-12 col-md-6">
                <div class="bg-light rounded overflow-hidden shadow-sm">
                    <img src="<%= product.image %>" class="img-fluid w-100 object-fit-cover" alt="<%= product.name %>">
                </div>
            </div>
            <div class="col-12 col-md-6">
                <h1 class="display-5 fw-bold mb-3"><%= product.name %></h1>
                <h3 class="text-primary fw-bold mb-4"><%= product.price %> $</h3>
                
                <p class="lead text-muted mb-5"><%= product.description %></p>
                
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <form action="/cart" method="POST" class="row g-3 align-items-end">
                            <div class="col-auto">
                                <label for="amount" class="form-label fw-bold">Quantity</label>
                                <input type="number" name="amount" id="amount" class="form-control" value="1" min="1" style="width: 100px;">
                            </div>
                            <div class="col">
                                <input type="hidden" name="name" value="<%= product.name %>">
                                <input type="hidden" name="price" value="<%= product.price %>">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <input type="hidden" name="redirectTo" value="/product/<%= product._id %>">
                                <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include('parts/footer') %>