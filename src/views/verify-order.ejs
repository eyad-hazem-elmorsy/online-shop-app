<%- include('parts/header') %>
<%- include('parts/navbar') %>
<%- include('parts/flash-messages') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center">Checkout</h3>
                    <p class="text-muted text-center mb-4">Please enter your shipping address to complete the order.</p>

                    <form action="/orders" method="POST">
                        <div class="mb-4">
                            <label class="form-label">Shipping Address</label>
                            <input type="text" name="address" class="form-control" placeholder="123 Main St, City, Country" required>
                        </div>
                        <button type="submit" class="btn btn-success w-100 btn-lg">Place Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('parts/footer') %>