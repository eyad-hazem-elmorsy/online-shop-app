<%- include('parts/header') %>
<%- include('parts/navbar') %>

<% if (validationError) { %>
    <p class="alert alert-danger">
        <%= validationError.message %>
    </p>
<% } %>
<% if (Error) { %>
    <p class="alert alert-danger">
        <%= Error.message %>
    </p>
<% } %>

<div class="container">
    <% if (items.length === 0) { %>
        <p class="alert alert-danger">There is no items</p>
    <% } else { %>
        <table>
            <thead>
                <td>no</td>
                <td>Product name</td>
                <td>Price</td>
                <td>Amount</td>
                <td>Total</td>
                <td></td>
            </thead>
            <tbody>
                <% for (let i = 0; i < items.length; ++i) { %>
                    <tr>
                        <td> <%= i + 1 %> </td>
                        <td> <%= items[i].name %> </td>
                        <td> <%= items[i].price %> $ </td>
                        <form method="POST">
                            <td> <input type="number" name="amount" class="form-control" value="<%= items[i].amount %>"> </td>
                            <td> <%= items[i].price * items[i].amount %> $ </td>
                            <td>
                                <input type="hidden" name="cartId" value="<%= items[i]._id %>">
                                <input type="hidden" name="redirectTo", value="/cart">
                                <input type="submit" class="btn btn-success" value="Save" formaction="/cart/save">
                                <input type="submit" class="btn btn-danger" value="Delete" formaction="/cart/delete">
                            </td>
                        </form>
                    </tr>
                <% } %>
            </tbody>
        </table>
    <% } %>
    <% if (items.length) { %>
        <form method="POST" action="/cart/delete-all">
            <input type="submit" class="btn btn-danger" value="Delete All">
        </form>
    <% } %>
    <form method="GET" action="/orders/verify">
        <input type="submit" class="btn btn-success" value="Place Order">
    </form>
</div>

<%- include('parts/footer') %>